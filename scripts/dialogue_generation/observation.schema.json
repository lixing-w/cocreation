{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video observation with finite asset attributes",
  "type": "object",
  "required": [
    "assets",
    "shots"
  ],
  "properties": {
    "attribute_schema_version": {
      "const": 2
    },
    "video": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "name",
              "description",
              "frames",
              "attributes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "person"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "attributes": {
                "type": "object",
                "required": [
                  "gender_presentation",
                  "age_group",
                  "hair_length",
                  "hair_style",
                  "hair_color",
                  "face_shape",
                  "eye_shape",
                  "eyebrow_shape",
                  "nose_shape",
                  "lip_shape",
                  "expression",
                  "makeup_intensity",
                  "facial_hair",
                  "height",
                  "body_build",
                  "clothing_type",
                  "clothing_color",
                  "clothing_fit",
                  "accessory"
                ],
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                },
                "properties": {
                  "gender_presentation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "age_group": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hair_length": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hair_style": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hair_color": {
                    "type": "string",
                    "minLength": 1
                  },
                  "face_shape": {
                    "type": "string",
                    "minLength": 1
                  },
                  "eye_shape": {
                    "type": "string",
                    "minLength": 1
                  },
                  "eyebrow_shape": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nose_shape": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lip_shape": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expression": {
                    "type": "string",
                    "minLength": 1
                  },
                  "makeup_intensity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "facial_hair": {
                    "type": "string",
                    "minLength": 1
                  },
                  "height": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body_build": {
                    "type": "string",
                    "minLength": 1
                  },
                  "clothing_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "clothing_color": {
                    "type": "string",
                    "minLength": 1
                  },
                  "clothing_fit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accessory": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "hair_length": {
                          "enum": [
                            "bald"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "hair_style": {
                          "enum": [
                            "unknown",
                            "not applicable"
                          ]
                        },
                        "hair_color": {
                          "enum": [
                            "unknown",
                            "not applicable"
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "name",
              "description",
              "frames",
              "attributes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "object"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "attributes": {
                "type": "object",
                "required": [
                  "color",
                  "color_lightness",
                  "color_saturation",
                  "size",
                  "shape",
                  "aspect_ratio",
                  "material",
                  "surface_finish",
                  "texture",
                  "pattern",
                  "decoration",
                  "condition",
                  "transparency"
                ],
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                },
                "properties": {
                  "color": {
                    "type": "string",
                    "minLength": 1
                  },
                  "color_lightness": {
                    "type": "string",
                    "minLength": 1
                  },
                  "color_saturation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "size": {
                    "type": "string",
                    "minLength": 1
                  },
                  "shape": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "minLength": 1
                  },
                  "material": {
                    "type": "string",
                    "minLength": 1
                  },
                  "surface_finish": {
                    "type": "string",
                    "minLength": 1
                  },
                  "texture": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pattern": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decoration": {
                    "type": "string",
                    "minLength": 1
                  },
                  "condition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "transparency": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "transparency": {
                          "enum": [
                            "transparent",
                            "translucent"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "material": {
                          "enum": [
                            "glass",
                            "plastic",
                            "unknown"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "surface_finish": {
                          "enum": [
                            "brushed"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "material": {
                          "enum": [
                            "metal",
                            "unknown"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "surface_finish": {
                          "enum": [
                            "glazed"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "material": {
                          "enum": [
                            "ceramic",
                            "unknown"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "color": {
                          "enum": [
                            "black",
                            "white",
                            "gray",
                            "colorless"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "color_saturation": {
                          "enum": [
                            "unknown",
                            "not applicable"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "material": {
                          "enum": [
                            "canvas",
                            "cotton fabric",
                            "nylon",
                            "felt",
                            "paper"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "surface_finish": {
                          "enum": [
                            "matte",
                            "semi-matte",
                            "unknown",
                            "not applicable"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "color": {
                          "enum": [
                            "beige",
                            "brown",
                            "red",
                            "orange",
                            "yellow",
                            "green",
                            "cyan",
                            "blue",
                            "purple",
                            "pink",
                            "gold",
                            "silver",
                            "copper",
                            "multicolored",
                            "dark blue",
                            "light blue",
                            "dark green",
                            "light green",
                            "burgundy",
                            "khaki",
                            "off-white",
                            "neon green"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "color_saturation": {
                          "enum": [
                            "low saturation",
                            "medium saturation",
                            "high saturation",
                            "unknown"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "color": {
                          "enum": [
                            "colorless"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "transparency": {
                          "enum": [
                            "transparent",
                            "unknown"
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "name",
              "description",
              "frames",
              "attributes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "indoor_environment"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "attributes": {
                "type": "object",
                "required": [
                  "room_type",
                  "interior_style",
                  "space_size",
                  "ceiling_height",
                  "layout",
                  "wall_material",
                  "floor_material",
                  "palette",
                  "furniture_density",
                  "furniture_style",
                  "window_type",
                  "clutter",
                  "background_crowd",
                  "lighting_source",
                  "lighting_level",
                  "lighting_temperature",
                  "lighting_softness",
                  "time_of_day",
                  "camera_distance",
                  "season",
                  "weather"
                ],
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                },
                "properties": {
                  "room_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "interior_style": {
                    "type": "string",
                    "minLength": 1
                  },
                  "space_size": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ceiling_height": {
                    "type": "string",
                    "minLength": 1
                  },
                  "layout": {
                    "type": "string",
                    "minLength": 1
                  },
                  "wall_material": {
                    "type": "string",
                    "minLength": 1
                  },
                  "floor_material": {
                    "type": "string",
                    "minLength": 1
                  },
                  "palette": {
                    "type": "string",
                    "minLength": 1
                  },
                  "furniture_density": {
                    "type": "string",
                    "minLength": 1
                  },
                  "furniture_style": {
                    "type": "string",
                    "minLength": 1
                  },
                  "window_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "clutter": {
                    "type": "string",
                    "minLength": 1
                  },
                  "background_crowd": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lighting_source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lighting_level": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lighting_temperature": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lighting_softness": {
                    "type": "string",
                    "minLength": 1
                  },
                  "time_of_day": {
                    "type": "string",
                    "minLength": 1
                  },
                  "camera_distance": {
                    "type": "string",
                    "minLength": 1
                  },
                  "season": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weather": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "time_of_day": {
                          "enum": [
                            "night",
                            "late night"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "lighting_source": {
                          "enum": [
                            "moonlight",
                            "light through windows",
                            "indoor lights",
                            "streetlights",
                            "neon lights",
                            "campfire",
                            "mixed light sources",
                            "unknown",
                            "not applicable"
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "name",
              "description",
              "frames",
              "attributes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "outdoor_environment"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "attributes": {
                "type": "object",
                "required": [
                  "setting_type",
                  "geography",
                  "season",
                  "weather",
                  "surface_material",
                  "surface_condition",
                  "vegetation_density",
                  "vegetation_color",
                  "water_state",
                  "water_color",
                  "background_density",
                  "visibility",
                  "wind_level",
                  "background_crowd",
                  "lighting_source",
                  "lighting_level",
                  "lighting_temperature",
                  "lighting_softness",
                  "time_of_day",
                  "camera_distance"
                ],
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                },
                "properties": {
                  "setting_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "geography": {
                    "type": "string",
                    "minLength": 1
                  },
                  "season": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weather": {
                    "type": "string",
                    "minLength": 1
                  },
                  "surface_material": {
                    "type": "string",
                    "minLength": 1
                  },
                  "surface_condition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "vegetation_density": {
                    "type": "string",
                    "minLength": 1
                  },
                  "vegetation_color": {
                    "type": "string",
                    "minLength": 1
                  },
                  "water_state": {
                    "type": "string",
                    "minLength": 1
                  },
                  "water_color": {
                    "type": "string",
                    "minLength": 1
                  },
                  "background_density": {
                    "type": "string",
                    "minLength": 1
                  },
                  "visibility": {
                    "type": "string",
                    "minLength": 1
                  },
                  "wind_level": {
                    "type": "string",
                    "minLength": 1
                  },
                  "background_crowd": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lighting_source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lighting_level": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lighting_temperature": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lighting_softness": {
                    "type": "string",
                    "minLength": 1
                  },
                  "time_of_day": {
                    "type": "string",
                    "minLength": 1
                  },
                  "camera_distance": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "time_of_day": {
                          "enum": [
                            "night",
                            "late night"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "lighting_source": {
                          "enum": [
                            "moonlight",
                            "light through windows",
                            "indoor lights",
                            "streetlights",
                            "neon lights",
                            "campfire",
                            "mixed light sources",
                            "unknown",
                            "not applicable"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "vegetation_density": {
                          "enum": [
                            "no vegetation"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "vegetation_color": {
                          "enum": [
                            "unknown",
                            "not applicable"
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "assets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "target_order": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "effect"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "global",
              "partial"
            ]
          },
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "image",
                    "video"
                  ]
                }
              },
              "asset_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "effect": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "season": {
                "enum": [
                  "spring",
                  "summer",
                  "fall",
                  "winter"
                ]
              },
              "aspect_ratio": {
                "enum": [
                  "portrait",
                  "landscape",
                  "square_assets_landscape_video",
                  "square_assets_portrait_video"
                ]
              },
              "asset_attributes": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "global"
                }
              }
            },
            "then": {
              "properties": {
                "selector": {
                  "maxProperties": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "partial"
                }
              }
            },
            "then": {
              "required": [
                "selector"
              ],
              "properties": {
                "selector": {
                  "minProperties": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
